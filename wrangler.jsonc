{
	// Ссылка на JSON-схему для валидации
	// Помогает VS Codium подсказывать доступные поля и проверять ошибки
	"$schema": "./node_modules/wrangler/config-schema.json",

	// Имя твоего проекта в Cloudflare
	// Будет использоваться как часть URL: arthur-chukrakov.workers.dev
	"name": "arthur-chukrakov",

	// Дата совместимости с Cloudflare Workers API
	// Cloudflare иногда меняет поведение API, эта дата фиксирует версию
	// Формат: YYYY-MM-DD (обычно ставят текущую дату при создании)
	"compatibility_date": "2026-06-14",

	// Флаги совместимости — включают экспериментальные или специфичные фичи
	"compatibility_flags": [
		// Включает Node.js Async Local Storage
		// Нужно для работы некоторых библиотек, которые используют контекст запроса
		// Например, для хранения данных о текущем пользователе в middleware
		"nodejs_als"
	],

	// Точка входа для Cloudflare Worker
	// Это собранный SvelteKit файл, который обрабатывает серверные запросы
	// SvelteKit создаёт его при сборке в папке .svelte-kit/cloudflare/
	"main": ".svelte-kit/cloudflare/_worker.js",

	// Настройка статических файлов (CSS, JS, картинки, шрифты)
	// SvelteKit разделяет проект на:
	//   - Worker (серверная логика, API routes)
	//   - Assets (статика, которая раздаётся через CDN)
	"assets": {
		// Имя binding'а для доступа к статике из кода worker'а
		// Обычно не используется напрямую, но нужно для корректной работы
		"binding": "ASSETS",

		// Папка со статическими файлами после сборки
		// SvelteKit кладёт туда всё, что не требует серверной обработки
		"directory": ".svelte-kit/cloudflare"
	},

	// Использовать бесплатный поддомен workers.dev
	// Твой сайт будет доступен по адресу: arthur-chukrakov.workers.dev
	// Если false — нужно привязывать свой домен
	"workers_dev": true,

	// Генерировать URL для preview-деплоев
	// При пуше в ветку (не main) создаётся временный URL для тестирования
	// Полезно для проверки изменений перед деплоем в продакшен
	"preview_urls": true
}
